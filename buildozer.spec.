[app]
title = APRESON ULTIMATE
package.name = apreson
package.domain = org.apreson
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,json,ttf
version = 1.0

requirements = python3,kivy,libffi==3.4.4

android.accept_sdk_license = True

orientation = landscape
fullscreen = 0

android.permissions = INTERNET
android.api = 31
android.minapi = 24
android.ndk = 25b
android.archs = arm64-v8a, armeabi-v7a
android.allow_backup = True

# إخبار Buildozer بمسار Ant المحلي
android.ant_path = /usr/share/ant

[buildozer]
log_level = 2
warn_on_root = 1
