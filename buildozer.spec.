[app]
title = APRESON ULTIMATE
package.name = apreson
package.domain = org.apreson
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,json,ttf
version = 1.0

# المتطلبات الأساسية فقط
requirements = python3,kivy

# قبول تراخيص أندرويد تلقائياً
android.accept_sdk_license = True

# إعدادات الشاشة
orientation = landscape
fullscreen = 0

# إعدادات أندرويد (تم تعديل minapi إلى 24 لحل مشكلة التوافق)
android.permissions = INTERNET
android.api = 31
android.minapi = 25
android.archs = arm64-v8a, armeabi-v7a
android.allow_backup = True

[buildozer]
log_level = 2
warn_on_root = 1
